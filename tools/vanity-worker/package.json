{
  "name": "vanity-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "node --experimental-strip-types scripts/generate-modules.ts",
    "publish-modules": "node --experimental-strip-types scripts/publish-modules.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
